{
  "base_url": "index.html",
  "viewports": ["desktop", "mobile"],
  "long_loading_frames_ms": [500, 4000, 12000],
  "routes": [
    {
      "name": "login",
      "path": "#/login",
      "states": ["default", "loading", "error", "locked"]
    },
    {
      "name": "list",
      "path": "#/list",
      "states": ["default", "empty", "loading", "error", "partial"]
    },
    {
      "name": "detail",
      "path": "#/detail/1",
      "states": ["default", "loading", "long-loading", "error", "partial"],
      "motion_trigger": "[data-motion-trigger]"
    },
    {
      "name": "settings",
      "path": "#/settings",
      "states": ["default", "loading", "error"]
    }
  ]
}
